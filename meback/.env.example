# Server Configuration
PORT=3001
NODE_ENV=development

# Database (Use local MongoDB for development)
MONGODB_URI=mongodb://localhost:27017/portfolio

# GitHub API (Optional - leave empty to disable GitHub features)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_USERNAME=your_github_username

# CORS
FRONTEND_URL=http://localhost:3000

# Authentication (Change this in production!)
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random_for_production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cron Jobs
GITHUB_SYNC_CRON=0 */6 * * *